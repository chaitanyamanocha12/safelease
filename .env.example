# ─────────────────────────────────────────────────────────────────────────────
# SafeLease environment configuration. Copy to .env and fill in what you have.
# Every external provider is OPTIONAL. Unconfigured providers report
# NOT CONFIGURED in the UI and the rest of the app keeps working.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Core
APP_URL=http://localhost:3000
# Local SQLite file (dev). For hosted deployments use a libSQL/Turso URL:
#   DATABASE_URL=libsql://<db>-<org>.turso.io   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/safelease.db
DATABASE_AUTH_TOKEN=
# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Enables the seeded demo accounts, the demo sign-in button and demo reset.
# Keep false in production.
DEMO_MODE=true

# Private file storage: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/private
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI language model (Anthropic Claude). Without a key, SafeLease runs its
# clearly labeled deterministic engine (no LLM).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_CALLS_PER_RUN=4
LLM_TIMEOUT_MS=45000
LLM_DAILY_USER_BUDGET_USD=2

# OCR for screenshots / scanned leases: local (bundled Tesseract) | google_vision | llm_vision | none
OCR_PROVIDER=local
GOOGLE_CLOUD_VISION_API_KEY=

# Public web research (landlord / property manager lookups): brave | none
WEB_SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=

# Reverse image search: google_vision_web | none  (uses GOOGLE_CLOUD_VISION_API_KEY)
IMAGE_MATCH_PROVIDER=none

# Address geocoding: nominatim | none
# Nominatim's public service requires an identifying User-Agent, max 1 req/s,
# and no bulk use: https://operations.osmfoundation.org/policies/nominatim/
GEOCODER_PROVIDER=none
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=

# Routing / commute (driving + walking only; transit is not provided): openrouteservice | none
ROUTING_PROVIDER=none
OPENROUTESERVICE_API_KEY=

# Map tiles (Leaflet). Default: OpenStreetMap standard tiles (light use only).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Licensed rental feed (JSON, see API_INTEGRATIONS.md for the schema)
RENTAL_FEED_URL=
RENTAL_FEED_API_KEY=
RENTAL_FEED_NAME=Licensed partner feed

# Email: resend | dev_log | none
# dev_log writes emails to the server console only (NOT delivered) and is
# reported as DEMO status.
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=

# Protects /api/cron (scheduled monitoring jobs). Required for hosted cron.
CRON_SECRET=
# Allow fetching public listing URLs (SSRF-guarded). Set false to disable.
URL_FETCH_ENABLED=true

# Agent budgets
AGENT_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=24
AGENT_TOOL_TIMEOUT_MS=20000
