# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SafeLease local data (never commit)
/data/
/storage/
!.env.example
/playwright-report/
/test-results/
/blob-report/
/.vitest/
*.db
*.db-journal
*.db-wal
*.db-shm

# Pitch film, recordings and other media (kept local, not part of the app)
/pitch/
/ScreenRecording_*
*.MP4
*.mp4
*.mov
